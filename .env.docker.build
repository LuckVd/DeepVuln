# ============================================
# DeepVuln Docker 构建环境变量配置
# 用于国内网络环境下的构建优化
# ============================================
# 使用方法: cp .env.docker.build .env.docker.build.local
#          然后 docker-compose -f docker-compose-build.yml build

# ============================================
# APT 镜像源（推荐使用清华镜像）
# ============================================
APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian

# ============================================
# 构建时代理设置
# ============================================
# 格式: socks5://host.docker.internal:7891 或 http://host.docker.internal:7890
# 注意: 使用 host.docker.internal 让容器访问宿主机代理
# 如果不需要代理，留空即可
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
# 排除国内镜像和局域网地址（重要！避免国内源走代理导致证书问题）
BUILD_NO_PROXY=localhost,127.0.0.1,::1,10.*,192.168.*,172.16.*,mirrors.tuna.tsinghua.edu.cn,mirrors.aliyun.com,pypi.tuna.tsinghua.edu.cn,repo.huaweicloud.com,ghproxy.net,goproxy.cn

# ============================================
# Go 下载配置
# ============================================
# 主下载地址（默认官方，可能需要代理）
GO_DOWNLOAD_URL=https://go.dev/dl/go1.22.0.linux-amd64.tar.gz
# 备用下载地址（国内代理，不需要代理）
GO_DOWNLOAD_FALLBACK_URL=https://goproxy.cn/dl/go1.22.0.linux-amd64.tar.gz

# ============================================
# CodeQL 下载配置
# ============================================
# 主下载地址（留空使用默认 GitHub）
CODEQL_DOWNLOAD_URL=
# 备用下载地址（国内代理，不需要代理）
CODEQL_DOWNLOAD_FALLBACK_URL=https://ghproxy.net/https://github.com/github/codeql-cli-binaries/releases/download/v2.25.1/codeql-linux64.zip

# ============================================
# CodeQL Pack 预加载
# ============================================
# 如果网络不好，可以设为 false 跳过预加载，运行时再下载
PRELOAD_CODEQL_PACKS=false
