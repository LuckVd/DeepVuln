# DeepVuln Web 服务环境变量配置
# 复制此文件为 .env 并根据需要修改

# OpenAI API 配置
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.lkeap.cloud.tencent.com/coding/v3

# APT 镜像源（可选，用于加速构建）
APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian

# 数据库配置（如果使用外部数据库）。注意：代码读取 DEEPVULN_DB_* 前缀，
# DATABASE_URL 不会生效（audit B3）。
# DEEPVULN_DB_URL=postgresql+asyncpg://deepvuln:deepvuln_password@localhost:5432/deepvuln

# Redis 配置（如果使用外部 Redis）
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# WebSocket 进度广播用的 Redis（必须与 broker 同一实例；不设置时自动回退 broker URL）
# CELERY_REDIS_URL=redis://localhost:6379/0

# 安全（生产必须设置！）：未设置时 web 服务在默认 JWT secret 下拒绝启动。
# 生成：openssl rand -hex 32
DEEPVULN_SECURITY_JWT_SECRET=change-me-openssl-rand-hex-32
# 本机开发可暂时开启（跳过默认 secret 守卫）；生产保持 false
# DEEPVULN_SECURITY_DEV_MODE=true

# 本地路径扫描白名单（可选，逗号分隔绝对路径）：设置后 source_type=local 的
# 扫描路径必须位于这些根目录内；不设置时仅拒绝敏感系统路径（/etc、/proc 等）
# DEEPVULN_WEB_LOCAL_SCAN_ROOTS=/opt/pro/DeepVuln,/srv/code

# LLM 调用追踪（可选）：设置后每次 LLM 调用的完整请求/响应/usage 以 JSONL
# 追加写入 <目录>/llm_trace.jsonl（benchmark 排查与 token 审计用）
# DEEPVULN_LLM_TRACE=./data/llm_trace

# 日志落盘（可选）：默认仅 Rich 输出到 stderr
# DEEPVULN_LOGGING_FILE=./logs/deepvuln.log
# DEEPVULN_LOGGING_LEVEL=INFO
